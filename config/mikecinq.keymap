#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        CapsWord {
            bindings = <&caps_word>;
            key-positions = <3 4>;
            layers = <0 1>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        SystemLayer {
            bindings = <&mo 4>;
            key-positions = <31 34>;
            layers = <0 1>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <13 12>;
            layers = <0 2 1>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <13 14>;
            timeout-ms = <20>;
            layers = <0 1>;
            require-prior-idle-ms = <150>;
        };

        Delete {
            bindings = <&kp DELETE>;
            key-positions = <3 2>;
            timeout-ms = <20>;
            layers = <0 1>;
            require-prior-idle-ms = <150>;
        };

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <2 1>;
            timeout-ms = <20>;
            layers = <0 1>;
            require-prior-idle-ms = <150>;
        };

        Copy {
            bindings = <&kp LC(C)>;
            key-positions = <21 22>;
        };

        Cut {
            bindings = <&kp LC(X)>;
            key-positions = <22 23>;
        };

        Paste {
            bindings = <&kp LC(V)>;
            key-positions = <23 24>;
        };

        Undo {
            bindings = <&kp LC(Z)>;
            key-positions = <12 11>;
        };

        NumBackspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <3 2>;
            timeout-ms = <20>;
            layers = <2>;
            require-prior-idle-ms = <150>;
        };
    };

    behaviors {
        as: as {
            compatible = "zmk,behavior-hold-tap";
            label = "AS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        ColemakDH_Base {
            bindings = <
&as LS(Q) Q  &as LS(W) W  &as LS(F) F  &as LS(P) P  &as LS(B) B  &as LS(J) J  &as LS(L) L      &as LS(U) U          &as LS(Y) Y       &as LS(SQT) SQT
&as LS(A) A  &as LS(R) R  &as LS(S) S  &as LS(T) T  &as LS(G) G  &as LS(M) M  &as LS(N) N      &as LS(E) E          &as LS(I) I       &as LS(O) O
&as LS(Z) Z  &as LS(X) X  &as LS(C) C  &as LS(D) D  &as LS(V) V  &as LS(K) K  &as LS(H) H      &as SEMICOLON COMMA  &as COLON PERIOD  &as EXCLAMATION QUESTION
                          &none        &lt 2 SPACE  &none        &none        &lt 3 BACKSPACE  &none
            >;
        };

        Rupestris_Base {
            bindings = <
&as LS(Z) Z  &as LS(L) L                     &as LS(R) R  &as LS(K) K  &as LS(F) F  &as LS(V) V  &as LS(W) W      &as LS(U) U          &as LS(O) O       &as LS(Y) Y
&as LS(S) S  &as LS(T) T                     &as LS(N) N  &as LS(D) D  &as LS(P) P  &as LS(M) M  &as LS(G) G      &as LS(E) E          &as LS(A) A       &as LS(I) I
&as LS(X) X  &as DOUBLE_QUOTES SINGLE_QUOTE  &as LS(Q) Q  &as LS(H) H  &as LS(B) B  &as LS(C) C  &as LS(H) H      &as SEMICOLON COMMA  &as COLON PERIOD  &as EXCLAMATION QUESTION
                                             &none        &lt 2 SPACE  &none        &none        &lt 3 BACKSPACE  &none
            >;
        };

        NumNav {
            bindings = <
&none         &kp NUMBER_7           &kp NUMBER_8        &kp NUMBER_9             &kp N0      &kp LG(LS(NUMBER_4))  &none     &kp UP    &none      &none
&kp LEFT_GUI  &as NUMBER_4 LEFT_ALT  &as LCTRL NUMBER_5  &as LEFT_SHIFT NUMBER_6  &kp PERIOD  &kp LG(LS(NUMBER_5))  &kp LEFT  &kp DOWN  &kp RIGHT  &none
&none         &kp NUMBER_1           &kp NUMBER_2        &kp NUMBER_3             &kp MINUS   &none                 &none     &none     &none      &none
                                     &none               &trans                   &none       &none                 &trans    &none
            >;
        };

        SymSys {
            bindings = <
&kp CARET     &kp PIPE   &kp BACKSLASH  &kp SLASH         &kp EQUAL  &kp GRAVE    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none  &none
&kp ASTERISK  &kp HASH   &kp AMPERSAND  &kp AT_SIGN       &kp PLUS   &kp PERCENT  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none  &none
&kp TILDE     &kp UNDER  &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS  &kp DOLLAR   &kp LEFT_BRACE        &kp RIGHT_BRACE        &none  &none
                         &none          &trans            &none      &none        &trans                &none
            >;
        };

        System {
            bindings = <
&tog 1  &none  &none  &none   &none  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4
&none   &none  &none  &none   &none  &bt BT_CLR    &bt BT_CLR_ALL  &none         &none           &none
&none   &none  &none  &none   &none  &none         &none           &sys_reset    &studio_unlock  &bootloader
               &none  &trans  &none  &none         &trans          &none
            >;
        };
    };
};
